# APP_URL: URL triển khai ứng dụng (tự động cung cấp trong môi trường triển khai)
APP_URL="http://localhost:3000"

# PORT: Cổng chạy máy chủ Express (mặc định 3000)
PORT="3000"

# ADMIN_PASSCODE: Mật khẩu đăng nhập quản trị viên cấp chủ cửa hàng (để trống nếu muốn thiết lập lần đầu qua giao diện /quan-tri)
ADMIN_PASSCODE=

# ADMIN_EMAIL: Email tài khoản chủ cửa hàng mặc định cho quản trị (tùy chọn)
ADMIN_EMAIL="admin@hoanelly.vn"

# DB_PATH: Đường dẫn tệp cơ sở dữ liệu SQLite (mặc định ./data/hoanelly.db)
DB_PATH="./data/hoanelly.db"

# UPLOAD_DIR: Thư mục lưu tệp ảnh khách hàng tải lên (mặc định ./data/uploads)
UPLOAD_DIR="./data/uploads"

# IMAGE_CACHE_DIR: Thư mục đệm lưu ảnh đã thay đổi kích thước và tối ưu WebP (mặc định ./data/image-cache)
IMAGE_CACHE_DIR="./data/image-cache"

